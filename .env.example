# Database Configuration (from Neon)
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# NextAuth Configuration
NEXTAUTH_SECRET=your-generated-secret-key
NEXTAUTH_URL=https://your-app.vercel.app

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GoPay Payment Gateway (Optional)
GOPAY_GO_ID=your-gopay-go-id
GOPAY_CLIENT_ID=your-gopay-client-id
GOPAY_CLIENT_SECRET=your-gopay-client-secret
GOPAY_ENVIRONMENT=test

# Resend Email Service (Optional)
RESEND_API_KEY=your-resend-api-key

# Cloudinary File Storage (Optional)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Zásilkovna API (Optional)
ZASILKOVNA_API_KEY=your-zasilkovna-api-key

